{
  "name": "test-app",
  "version": "1.0.0",
  "type": "module",
  "description": "Test application for BUDA framework",
  "scripts": {
    "dev": "vite",
    "build": "vite build", 
    "preview": "vite preview",
    "server": "node server.ts",
    "start": "concurrently \"npm run dev\" \"npm run server\"",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint \"{src,buses,models,services,ui,wire}/**/*.{ts,js,svelte}\" --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "lint:check": "npm run lint -- --quiet",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "budget": "tsx tools/complexity-budget.ts",
    "delete-simulation": "tsx tools/delete-simulation.ts", 
    "design-doc-check": "tsx tools/design-doc-checker.ts",
    "boss:init": "npm install && npm run boss:setup-hooks",
    "boss:setup-hooks": "husky install",
    "boss:validate": "npm run lint && npm run budget && npm run test:run",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.0.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/svelte": "^4.2.3",
    "@tsconfig/svelte": "^5.0.5",
    "@types/node": "^24.3.0", 
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitest/coverage-v8": "^1.6.1",
    "concurrently": "^9.2.1",
    "eslint": "^8.57.1",
    "eslint-plugin-boss": "file:tools/eslint-plugin-boss",
    "eslint-plugin-svelte": "^2.46.1",
    "glob": "^10.0.0",
    "husky": "^8.0.3",
    "jsdom": "^24.1.3",
    "lint-staged": "^15.5.2",
    "svelte": "^4.0.0",
    "svelte-check": "^4.3.1",
    "tsx": "^4.0.0",
    "typescript": "^5.9.2",
    "vite": "^5.0.0",
    "vitest": "^1.6.1"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "hono": "^4.0.0"
  },
  "buda": {
    "version": "1.0.0",
    "framework": "svelte",
    "architecture": "lego-buses",
    "rules": "essential-boss-rules"
  }
}